<footer>«Бездна» — контент из content.json | Ctrl+E для локального редактирования | Данные кэшируются в браузере</footer>
 
<script>
    // ========== НАСТРОЙКИ ==========
    const GH_OWNER = 'weather-report22';
    const GH_REPO = 'weather-report22.github.io';
    const GH_BRANCH = 'main';
    const GH_FILE_PATH = 'content.json';
    const JSON_URL = `https://raw.githubusercontent.com/${GH_OWNER}/${GH_REPO}/${GH_BRANCH}/${GH_FILE_PATH}`;
    // =================================
 
    let chapters = [];
    let charactersData = [];
    let currentChapterIdx = 0;
 
    // DOM-элементы
    const chapterDiv = document.getElementById('chapterContent');
    const chapterSelect = document.getElementById('chapterSelect');
    const chapterSearch = document.getElementById('chapterSearch');
    const prevBtn = document.getElementById('prevChapter');
    const nextBtn = document.getElementById('nextChapter');
    const mobilePrev = document.getElementById('mobilePrev');
    const mobileNext = document.getElementById('mobileNext');
    const devPanel = document.getElementById('devPanel');
    const rawTextInput = document.getElementById('rawTextInput');
    const chapterTitleInput = document.getElementById('chapterTitleInput');
    const depthSelect = document.getElementById('depthSelect');
    const applyBtn = document.getElementById('applyTextFormatBtn');
    const exportBtn = document.getElementById('exportAllBtn');
    const importBtn = document.getElementById('importJsonBtn');
    const jsonFileInput = document.getElementById('jsonFileInput');
    const loreDiv = document.getElementById('loreContent');
    const loreTextInput = document.getElementById('loreTextInput');
    const applyLoreBtn = document.getElementById('applyLoreBtn');
    const charactersGrid = document.getElementById('charactersGrid');
    const characterEditList = document.getElementById('characterEditList');
    const addCharacterBtn = document.getElementById('addCharacterBtn');
    const themeToggle = document.getElementById('themeToggle');
    const devToggle = document.getElementById('devToggleBtn');
    const syncStatusSpan = document.getElementById('syncStatus');
    const addChapterBtn = document.getElementById('addChapterBtn');
    const deleteChapterBtn = document.getElementById('deleteChapterBtn');
    const moveChapterUpBtn = document.getElementById('moveChapterUpBtn');
    const moveChapterDownBtn = document.getElementById('moveChapterDownBtn');
    const ghTokenInput = document.getElementById('ghTokenInput');
    const rememberTokenCheck = document.getElementById('rememberTokenCheck');
    const saveTokenBtn = document.getElementById('saveTokenBtn');
    const clearTokenBtn = document.getElementById('clearTokenBtn');
    const tokenStatus = document.getElementById('tokenStatus');
    const publishBtn = document.getElementById('publishBtn');
    const publishStatus = document.getElementById('publishStatus');
    const refreshFromGithubBtn = document.getElementById('refreshFromGithubBtn');
 
    // Хелперы
    function escapeHtml(str) { return str.replace(/[&<>]/g, m => m=='&'?'&amp;': m=='<'?'&lt;':'&gt;'); }
    function escapeAttr(str) { return (str||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    function smartParagraphs(rawText) {
        if (!rawText.trim()) return "<p><em>Пустая глава</em></p>";
        let text = rawText.trim();
        if (text.includes("\n\n")) {
            let blocks = text.split(/\n\s*\n/);
            return blocks.map(b => `<p>${escapeHtml(b.replace(/\n/g, ' ').trim())}</p>`).join('');
        }
        let sentences = text.split(/(?<=[.!?])\s+/);
        let paragraphs = [], buf = [];
        for (let s of sentences) {
            buf.push(s);
            if (buf.length >= 3 || (s.length>70 && buf.length>=2) || s === sentences[sentences.length-1]) {
                paragraphs.push(buf.join(' '));
                buf = [];
            }
        }
        if (!paragraphs.length) paragraphs = [text];
        return paragraphs.map(p => `<p>${escapeHtml(p)}</p>`).join('');
    }
    function extractPlain(html) { let d=document.createElement('div'); d.innerHTML=html; return d.innerText; }
    function toBase64Utf8(str) {
        const bytes = new TextEncoder().encode(str);
        let binary = '';
        bytes.forEach(b => { binary += String.fromCharCode(b); });
        return btoa(binary);
    }
 
    // Сохранение в localStorage (кеш)
    function saveToLocalCache() {
        const data = { chapters, lore: loreDiv.innerHTML, characters: charactersData, currentChapterIdx };
        localStorage.setItem('abyss_cache', JSON.stringify(data));
    }
    function loadFromLocalCache() {
        const saved = localStorage.getItem('abyss_cache');
        if (saved) {
            try {
                const data = JSON.parse(saved);
                if (data.chapters) chapters = data.chapters;
                if (data.lore) loreDiv.innerHTML = data.lore;
                if (data.characters) charactersData = data.characters;
                if (typeof data.currentChapterIdx === 'number') currentChapterIdx = data.currentChapterIdx;
                return true;
            } catch(e) { return false; }
        }
        return false;
    }
 
    // Загрузка с GitHub (публичный raw-файл, без токена)
    async function loadFromGitHub() {
        syncStatusSpan.innerText = '☁️ загрузка...';
        try {
            const response = await fetch(JSON_URL, { cache: 'no-cache' });
            if (!response.ok) throw new Error(`HTTP ${response.status}`);
            const data = await response.json();
            if (data.chapters && data.chapters.length) chapters = data.chapters;
            if (data.lore) loreDiv.innerHTML = data.lore;
            if (data.characters) charactersData = data.characters;
            if (typeof data.currentChapterIdx === 'number') currentChapterIdx = data.currentChapterIdx;
            else if (currentChapterIdx >= chapters.length) currentChapterIdx = 0;
            saveToLocalCache();
            syncStatusSpan.innerText = '✅ синхр.';
            setTimeout(() => { if(syncStatusSpan.innerText === '✅ синхр.') syncStatusSpan.innerText = '☁️ онлайн'; }, 2000);
            return true;
        } catch (err) {
            console.warn("Ошибка загрузки JSON с GitHub:", err);
            syncStatusSpan.innerText = '⚠️ офлайн';
            return false;
        }
    }
 
    // Инициализация: сначала пробуем загрузить из кэша, потом обновляем с GitHub
    async function initData() {
        const hasCache = loadFromLocalCache();
        if (hasCache && chapters.length) {
            renderCurrentChapter();
            renderCharacters();
        } else {
            chapters = [];
            loreDiv.innerHTML = "<p>Загрузка данных...</p>";
        }
        const success = await loadFromGitHub();
        if (success) {
            renderCurrentChapter();
            renderCharacters();
            updateDepthIndicator();
        } else if (!hasCache) {
            chapterDiv.innerHTML = "<p>Не удалось загрузить данные. Проверьте подключение к интернету или наличие файла content.json в репозитории.</p>";
            loreDiv.innerHTML = "<p>Ошибка загрузки лора.</p>";
        }
    }
 
    // UI функции — читалка
    function renderChapterSelector(filter="") {
        if (!chapters.length) { chapterSelect.innerHTML = ''; return; }
        let filtered = chapters.filter((ch) => ch.title.toLowerCase().includes(filter.toLowerCase()));
        chapterSelect.innerHTML = '';
        filtered.forEach(ch => {
            let idx = chapters.indexOf(ch);
            let opt = document.createElement('option');
            opt.value = idx;
            opt.textContent = `${idx+1}. ${ch.title} (${ch.depth} км)`;
            if (idx === currentChapterIdx) opt.selected = true;
            chapterSelect.appendChild(opt);
        });
    }
    function renderCurrentChapter() {
        if (!chapters.length) { chapterDiv.innerHTML = '<p><em>Глав пока нет. Добавьте первую во вкладке «Правка».</em></p>'; return; }
        chapterDiv.innerHTML = chapters[currentChapterIdx].contentHtml;
        renderChapterSelector(chapterSearch.value);
        updateDepthIndicator();
        saveToLocalCache();
        chapterDiv.scrollIntoView({ behavior:'smooth', block:'start' });
    }
    function updateDepthIndicator() {
        let depth = chapters[currentChapterIdx]?.depth ?? 0;
        document.querySelectorAll('.depth-tower span').forEach(span => {
            let val = parseInt(span.dataset.depth);
            span.classList.toggle('active', val === depth && chapters.length > 0);
        });
    }
    function fillDevPanel() {
        if (chapters[currentChapterIdx]) {
            chapterTitleInput.value = chapters[currentChapterIdx].title;
            rawTextInput.value = extractPlain(chapters[currentChapterIdx].contentHtml);
            depthSelect.value = chapters[currentChapterIdx].depth;
        } else {
            chapterTitleInput.value = '';
            rawTextInput.value = '';
        }
    }
    function changeChapter(delta) {
        if (!chapters.length) return;
        let newIdx = currentChapterIdx + delta;
        if (newIdx<0) newIdx=0;
        if (newIdx>=chapters.length) newIdx=chapters.length-1;
        if (newIdx !== currentChapterIdx) {
            currentChapterIdx = newIdx;
            renderCurrentChapter();
            if (devPanel.classList.contains('open')) fillDevPanel();
        }
    }
    function saveCurrentChapterLocal() {
        if (!chapters.length) return;
        chapters[currentChapterIdx].title = chapterTitleInput.value.trim() || `Глава ${currentChapterIdx+1}`;
        chapters[currentChapterIdx].contentHtml = smartParagraphs(rawTextInput.value);
        chapters[currentChapterIdx].depth = parseInt(depthSelect.value);
        renderCurrentChapter();
        saveToLocalCache();
        alert("Глава сохранена локально (только в вашем браузере). Чтобы обновить для всех, опубликуйте изменения во вкладке «Публикация».");
    }
    function exportAll() {
        let data = { chapters, lore: loreDiv.innerHTML, characters: charactersData, currentChapterIdx };
        let a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([JSON.stringify(data,null,2)], {type:'application/json'}));
        a.download = 'abyss_backup.json';
        a.click();
    }
    function importJson(file) {
        let reader = new FileReader();
        reader.onload = e => {
            try {
                let data = JSON.parse(e.target.result);
                if (data.chapters) chapters = data.chapters;
                if (data.lore) loreDiv.innerHTML = data.lore;
                if (data.characters) charactersData = data.characters;
                if (typeof data.currentChapterIdx === 'number') currentChapterIdx = data.currentChapterIdx;
                renderCurrentChapter();
                renderCharacters();
                renderCharacterEditList();
                loreTextInput.value = extractPlain(loreDiv.innerHTML);
                fillDevPanel();
                saveToLocalCache();
                alert("Импорт выполнен локально. Чтобы опубликовать для всех, используйте вкладку «Публикация».");
            } catch(err) { alert("Ошибка JSON"); }
        };
        reader.readAsText(file);
    }
    function renderCharacters() {
        charactersGrid.innerHTML = charactersData.map(ch => `
            <div class="character-card">
                <div class="char-avatar">${ch.icon}</div>
                <div class="char-name">${ch.name}</div>
                <div class="char-role">${ch.role}</div>
                <p>${ch.desc}</p>
            </div>
        `).join('');
    }
 
    // ===== Глава: добавление / удаление / перестановка =====
    addChapterBtn.onclick = () => {
        const newChapter = { title: `Новая глава`, depth: chapters[currentChapterIdx]?.depth ?? 0, contentHtml: '<p>Текст главы...</p>' };
        const insertAt = chapters.length ? currentChapterIdx + 1 : 0;
        chapters.splice(insertAt, 0, newChapter);
        currentChapterIdx = insertAt;
        renderCurrentChapter();
        fillDevPanel();
        saveToLocalCache();
    };
    deleteChapterBtn.onclick = () => {
        if (!chapters.length) return;
        if (!confirm(`Удалить главу "${chapters[currentChapterIdx].title}"? Это можно отменить только через «Обновить с GitHub» (до публикации).`)) return;
        chapters.splice(currentChapterIdx, 1);
        if (currentChapterIdx >= chapters.length) currentChapterIdx = Math.max(0, chapters.length-1);
        renderCurrentChapter();
        fillDevPanel();
        saveToLocalCache();
    };
    moveChapterUpBtn.onclick = () => {
        if (currentChapterIdx <= 0) return;
        [chapters[currentChapterIdx-1], chapters[currentChapterIdx]] = [chapters[currentChapterIdx], chapters[currentChapterIdx-1]];
        currentChapterIdx -= 1;
        renderCurrentChapter();
        saveToLocalCache();
    };
    moveChapterDownBtn.onclick = () => {
        if (currentChapterIdx >= chapters.length-1) return;
        [chapters[currentChapterIdx+1], chapters[currentChapterIdx]] = [chapters[currentChapterIdx], chapters[currentChapterIdx+1]];
        currentChapterIdx += 1;
        renderCurrentChapter();
        saveToLocalCache();
    };
 
    // ===== Энциклопедия =====
    applyLoreBtn.onclick = () => {
        loreDiv.innerHTML = smartParagraphs(loreTextInput.value);
        saveToLocalCache();
        alert("Энциклопедия сохранена локально.");
    };
 
    // ===== Персонажи: редактирование списка =====
    function renderCharacterEditList() {
        characterEditList.innerHTML = charactersData.map((ch, i) => `
            <div class="char-edit-row" data-index="${i}">
                <div class="row-line">
                    <input class="icon-input" data-field="icon" value="${escapeAttr(ch.icon)}" placeholder="🗡️">
                    <input data-field="name" value="${escapeAttr(ch.name)}" placeholder="Имя">
                    <input data-field="role" value="${escapeAttr(ch.role)}" placeholder="Роль">
                </div>
                <textarea data-field="desc" rows="2" placeholder="Описание">${escapeAttr(ch.desc)}</textarea>
                <div style="text-align:right;"><button class="btn-sm char-delete-btn" type="button">🗑 Удалить</button></div>
            </div>
        `).join('') || '<p style="font-size:0.85rem; opacity:0.8;">Персонажей пока нет.</p>';
    }
    characterEditList.addEventListener('input', e => {
        const row = e.target.closest('.char-edit-row');
        if (!row) return;
        const idx = parseInt(row.dataset.index);
        const field = e.target.dataset.field;
        if (field && charactersData[idx]) {
            charactersData[idx][field] = e.target.value;
            saveToLocalCache();
        }
    });
    characterEditList.addEventListener('click', e => {
        if (e.target.classList.contains('char-delete-btn')) {
            const row = e.target.closest('.char-edit-row');
            const idx = parseInt(row.dataset.index);
            if (confirm(`Удалить персонажа "${charactersData[idx].name}"?`)) {
                charactersData.splice(idx,1);
                renderCharacterEditList();
                renderCharacters();
                saveToLocalCache();
            }
        }
    });
    addCharacterBtn.onclick = () => {
        charactersData.push({ name: 'Новый персонаж', role: '', desc: '', icon: '❓' });
        renderCharacterEditList();
        renderCharacters();
        saveToLocalCache();
    };
 
    // ===== Токен GitHub =====
    function getStoredToken() {
        return sessionStorage.getItem('gh_token') || localStorage.getItem('gh_token') || '';
    }
    function updateTokenStatus() {
        const t = getStoredToken();
        const remembered = !!localStorage.getItem('gh_token');
        if (t) {
            tokenStatus.textContent = `🔑 Токен сохранён (${remembered ? 'постоянно в этом браузере' : 'до закрытия вкладки'}), заканчивается на ...${t.slice(-4)}`;
        } else {
            tokenStatus.textContent = '🔒 Токен не сохранён.';
        }
    }
    saveTokenBtn.onclick = () => {
        const t = ghTokenInput.value.trim();
        if (!t) { alert('Введите токен'); return; }
        if (rememberTokenCheck.checked) { localStorage.setItem('gh_token', t); sessionStorage.removeItem('gh_token'); }
        else { sessionStorage.setItem('gh_token', t); localStorage.removeItem('gh_token'); }
        ghTokenInput.value = '';
        updateTokenStatus();
    };
    clearTokenBtn.onclick = () => {
        localStorage.removeItem('gh_token');
        sessionStorage.removeItem('gh_token');
        updateTokenStatus();
        publishStatus.textContent = '';
    };
 
    // ===== Публикация в GitHub =====
    async function publishToGitHub() {
        const token = getStoredToken();
        if (!token) { publishStatus.textContent = '⚠️ Сначала сохраните токен GitHub выше.'; return; }
        publishBtn.disabled = true;
        publishStatus.textContent = '⏳ Получаю текущую версию файла...';
        try {
            const getRes = await fetch(`https://api.github.com/repos/${GH_OWNER}/${GH_REPO}/contents/${GH_FILE_PATH}?ref=${GH_BRANCH}`, {
                headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github+json' }
            });
            if (!getRes.ok) {
                if (getRes.status === 401) throw new Error('Токен недействителен или истёк.');
                if (getRes.status === 404) throw new Error('Файл content.json не найден в репозитории.');
                throw new Error(`GET ${getRes.status}`);
            }
            const fileData = await getRes.json();
 
            publishStatus.textContent = '⏳ Отправляю изменения...';
            const dataObj = { chapters, lore: loreDiv.innerHTML, characters: charactersData, currentChapterIdx };
            const content = toBase64Utf8(JSON.stringify(dataObj, null, 2));
            const putRes = await fetch(`https://api.github.com/repos/${GH_OWNER}/${GH_REPO}/contents/${GH_FILE_PATH}`, {
                method: 'PUT',
                headers: { 'Authorization': `Bearer ${token}`, 'Accept': 'application/vnd.github+json', 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    message: `Обновление контента через админ-панель — ${new Date().toLocaleString('ru-RU')}`,
                    content, sha: fileData.sha, branch: GH_BRANCH
                })
            });
            if (!putRes.ok) {
                const errBody = await putRes.json().catch(()=>({}));
                if (putRes.status === 401) throw new Error('Токен недействителен или не имеет прав на запись.');
                if (putRes.status === 409) throw new Error('Конфликт версий: файл изменился на GitHub. Нажмите «Обновить с GitHub» и повторите правки.');
                throw new Error(errBody.message || `PUT ${putRes.status}`);
            }
            publishStatus.textContent = '✅ Опубликовано! Изменения появятся на сайте в течение минуты (кэш GitHub Pages).';
            saveToLocalCache();
        } catch (err) {
            publishStatus.textContent = '❌ Ошибка: ' + err.message;
        } finally {
            publishBtn.disabled = false;
        }
    }
    publishBtn.onclick = publishToGitHub;
    refreshFromGithubBtn.onclick = async () => {
        publishStatus.textContent = '⏳ Загружаю актуальную версию с GitHub...';
        const ok = await loadFromGitHub();
        renderCurrentChapter();
        renderCharacters();
        renderCharacterEditList();
        loreTextInput.value = extractPlain(loreDiv.innerHTML);
        fillDevPanel();
        publishStatus.textContent = ok ? '✅ Загружена актуальная версия с GitHub.' : '⚠️ Не удалось обновить.';
    };
 
    // ===== Вкладки админ-панели =====
    document.querySelectorAll('.dev-tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.dev-tab-btn').forEach(b=>b.classList.remove('active'));
            document.querySelectorAll('.dev-tab-content').forEach(c=>c.classList.remove('active'));
            btn.classList.add('active');
            document.querySelector(`.dev-tab-content[data-tab-content="${btn.dataset.tab}"]`).classList.add('active');
            if (btn.dataset.tab === 'characters') renderCharacterEditList();
            if (btn.dataset.tab === 'lore') loreTextInput.value = extractPlain(loreDiv.innerHTML);
            if (btn.dataset.tab === 'publish') updateTokenStatus();
        });
    });
 
    // Тема
    function setTheme(theme) {
        if (theme === 'light') { document.body.classList.add('light'); document.body.classList.remove('dark'); }
        else { document.body.classList.add('dark'); document.body.classList.remove('light'); }
        localStorage.setItem('theme_pref', theme);
    }
    let curTheme = localStorage.getItem('theme_pref') || 'dark';
    setTheme(curTheme);
    themeToggle.onclick = () => setTheme(document.body.classList.contains('dark') ? 'light' : 'dark');
 
    // Секции
    const sections = { home: document.getElementById('home'), reader: document.getElementById('reader'), lore: document.getElementById('lore'), characters: document.getElementById('characters') };
    function showSection(id) {
        Object.values(sections).forEach(s => s.classList.remove('active-section'));
        sections[id].classList.add('active-section');
        localStorage.setItem('lastSection', id);
        if (id === 'characters') renderCharacters();
        if (id === 'reader') renderCurrentChapter();
    }
    document.querySelectorAll('.nav-btn[data-section]').forEach(btn => btn.addEventListener('click', () => showSection(btn.dataset.section)));
    document.getElementById('heroReadBtn').onclick = () => showSection('reader');
    document.getElementById('heroLoreBtn').onclick = () => showSection('lore');
    let lastSec = localStorage.getItem('lastSection');
    if (lastSec && sections[lastSec]) showSection(lastSec);
    else showSection('home');
 
    // Режим разработчика
    function toggleDevPanel() {
        devPanel.classList.toggle('open');
        if (devPanel.classList.contains('open')) {
            fillDevPanel();
            renderCharacterEditList();
            loreTextInput.value = extractPlain(loreDiv.innerHTML);
            updateTokenStatus();
        }
    }
    devToggle.onclick = toggleDevPanel;
    window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'e') { e.preventDefault(); toggleDevPanel(); }
    });
    applyBtn.onclick = saveCurrentChapterLocal;
    exportBtn.onclick = exportAll;
    importBtn.onclick = () => jsonFileInput.click();
    jsonFileInput.onchange = e => { if(e.target.files[0]) importJson(e.target.files[0]); jsonFileInput.value=''; };
 
    // Навигация
    prevBtn.onclick = () => changeChapter(-1);
    nextBtn.onclick = () => changeChapter(1);
    mobilePrev.onclick = () => changeChapter(-1);
    mobileNext.onclick = () => changeChapter(1);
    chapterSelect.onchange = (e) => { currentChapterIdx = parseInt(e.target.value); renderCurrentChapter(); if(devPanel.classList.contains('open')) fillDevPanel(); };
    chapterSearch.oninput = () => renderChapterSelector(chapterSearch.value);
 
    // Шрифт
    let fontSize = parseInt(localStorage.getItem('fontSize')) || 20;
    chapterDiv.style.fontSize = fontSize+'px';
    document.getElementById('fontPlus').onclick = () => { fontSize = Math.min(32, fontSize+2); chapterDiv.style.fontSize = fontSize+'px'; localStorage.setItem('fontSize', fontSize); };
    document.getElementById('fontMinus').onclick = () => { fontSize = Math.max(14, fontSize-2); chapterDiv.style.fontSize = fontSize+'px'; localStorage.setItem('fontSize', fontSize); };
 
    // Свайпы и стрелки
    let touchStart = 0;
    document.addEventListener('touchstart', e => { touchStart = e.changedTouches[0].screenX; });
    document.addEventListener('touchend', e => { let diff = e.changedTouches[0].screenX - touchStart; if (Math.abs(diff)>60) changeChapter(diff>0 ? -1 : 1); });
    window.addEventListener('keydown', e => { if(e.key === 'ArrowLeft') changeChapter(-1); if(e.key === 'ArrowRight') changeChapter(1); });
    window.addEventListener('beforeunload', () => { localStorage.setItem('scrollPos', window.scrollY); });
    window.addEventListener('load', () => { let sp = localStorage.getItem('scrollPos'); if(sp) window.scrollTo(0, parseInt(sp)); });
 
    // Анимация фона
    const wave1 = document.getElementById('wave1'), wave2 = document.getElementById('wave2');
    window.addEventListener('scroll', () => {
        let p = window.scrollY / (document.body.scrollHeight - window.innerHeight);
        if(wave1) wave1.style.transform = `translateX(${p*15}px) translateY(${p*6}px)`;
        if(wave2) wave2.style.transform = `translateX(${-p*12}px) translateY(${p*4}px)`;
    });
 
    // Запуск
    initData();
    setTimeout(() => window.dispatchEvent(new Event('scroll')), 100);
</script>
</body>
</html>
